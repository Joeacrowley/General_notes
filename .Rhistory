library(tidyverse)
result <- tryCatch(
{
# code that might throw a condition
1 / "a"
},
error = function(e) {
message("Caught an error: ", conditionMessage(e))
NA  # value to return instead
},
warning = function(w) {
message("Caught a warning: ", conditionMessage(w))
NULL
},
finally = {
message("This always runs, success or failure")
}
)
?trycatch
?tryCatch
conditionMessage(e)
