error = function(e) {
message("Caught an error: ", conditionMessage(e), " from ", deparse(conditionCall(e)))
NA
},
warning = function(w) {
message("Caught a warning: ", conditionMessage(w))
NULL
},
finally = {
message("This always runs, success or failure")
}
)
