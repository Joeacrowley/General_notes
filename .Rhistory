safe_log <- purrr::possibly(log, otherwise = NA_real_)
safe_log("a")
log("a")
safe_log <- purrr::possibly(log, otherwise = NA_real_)
safe_log(10)
safe_log("a")
log("a")
safe_log <- purrr::possibly(
log, # function to make safe
otherwise = NA_real_ # object to return in place of errors
)
safe_log(10)
log("a")
safe_log("a")
safe_log <-
purrr::possibly(
log, # function to make safe
otherwise = NA_real_ # object to return in place of errors
)
safe_log("a")
safe_log <- purrr::safely(log)
safe_log(10)
